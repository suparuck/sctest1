# Sender account used to send the email
GMAIL_USER=your-account@gmail.com

# Sender's SMTP password (for Gmail, this must be an App Password, NOT your
# regular Gmail password). Generate one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account)
GMAIL_APP_PASSWORD=your-16-char-app-password

# Recipient of the sample email
MAIL_TO=recipient@example.com

# --- Optional: use a different SMTP provider instead of Gmail ---
# Defaults below match Gmail's settings; override to point at another
# provider (Outlook, SendGrid, your own mail server, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# --- Optional: point at the local Mailpit test server from docker-compose.yml
# instead of a real SMTP provider. GMAIL_USER/GMAIL_APP_PASSWORD can be
# anything non-empty since Mailpit doesn't check credentials. View caught
# mail at http://localhost:8025 after `docker compose up`.
# GMAIL_USER=test@example.com
# GMAIL_APP_PASSWORD=test
# SMTP_HOST=smtp
# SMTP_PORT=1025
# SMTP_SECURE=false
